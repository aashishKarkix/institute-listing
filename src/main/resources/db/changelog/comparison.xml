<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet author="LISTING-INSTITUTE" id="20250917-100008">
        <createSequence sequenceName="comparison_id_seq" startValue="1" incrementBy="1"/>

        <createTable tableName="comparison">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_comparison"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="institution1_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="institution2_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="winner" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="comparison" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_comparison_user"/>
        <addForeignKeyConstraint baseTableName="comparison" baseColumnNames="institution1_id"
                                 referencedTableName="institutions" referencedColumnNames="id"
                                 constraintName="fk_comparison_institution1"/>
        <addForeignKeyConstraint baseTableName="comparison" baseColumnNames="institution2_id"
                                 referencedTableName="institutions" referencedColumnNames="id"
                                 constraintName="fk_comparison_institution2"/>
    </changeSet>
</databaseChangeLog>
