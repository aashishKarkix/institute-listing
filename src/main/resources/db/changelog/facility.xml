<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet author="LISTING-INSTITUTE" id="20250917-100005">
        <createSequence sequenceName="facilities_id_seq" startValue="1" incrementBy="1"/>

        <createTable tableName="facilities">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_facilities"/>
            </column>
            <column name="institution_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="available" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="services" type="jsonb">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="VARCHAR(500)"/>
            <column name="additional_info" type="VARCHAR(500)"/>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="facilities" baseColumnNames="institution_id"
                                 referencedTableName="institutions" referencedColumnNames="id"
                                 constraintName="fk_facility_institution"/>
    </changeSet>
</databaseChangeLog>
